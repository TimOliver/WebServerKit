// A hand-written map because the target's public headers sit next to
// GCDWebUploader.bundle, and SwiftPM refuses an umbrella header with sibling
// directories. Pointing at the headers from here keeps the bundle where the Xcode
// project and the podspec already expect it.
module GCDWebUploader {
    header "../GCDWebUploader.h"
    header "../GCDWebUploaderSSEChannel.h"
    export *
}
